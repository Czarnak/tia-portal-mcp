# PowerShell scripts are checked out CRLF on every platform.
#
# Without this, core.autocrlf=true stores LF in the index while working copies
# may hold either ending. Two files can then differ on disk while `git diff`
# reports nothing, because the index bytes are identical. That happened when
# two PowerShell acceptance scripts used different on-disk endings and a
# byte-identity check went red for a difference no committed content contained.
*.ps1 text eol=crlf

# The reference verifier hashes raw source bytes. Pin every text input so a
# clean checkout reproduces the embedded source hash on any Git configuration.
/Directory.Build.props text eol=crlf
/reference-stubs/Directory.Build.props text eol=crlf
/reference-stubs/Siemens.Engineering.Base/Siemens.Engineering.Base.csproj text eol=crlf
/reference-stubs/Siemens.Engineering.Step7/Siemens.Engineering.Step7.csproj text eol=crlf
/reference-stubs/Siemens.Engineering.WinCCUnified/Siemens.Engineering.WinCCUnified.csproj text eol=crlf
/reference-stubs/Siemens.Engineering.Base/**/*.cs text eol=crlf
/reference-stubs/Siemens.Engineering.Step7/**/*.cs text eol=crlf
/reference-stubs/Siemens.Engineering.WinCCUnified/**/*.cs text eol=crlf
/reference-stubs/Siemens.Engineering.PublicKey.snk binary

# Process material is collapsed by default in GitHub diffs (linguist-generated). Everything
# removed from the tree stays reachable through the tag docs-archive-2026-10-30. A bare
# directory pattern matches nothing, so '/**' is required. Reports are deliberately not matched.
/docs/superpowers/specs/** linguist-generated
/docs/superpowers/plans/** linguist-generated
/docs/superpowers/evidence/** linguist-generated
/docs/superpowers/evidence/** -text
/docs/superpowers/acceptance/reports/inputs/** linguist-generated
/docs/superpowers/acceptance/reports/inputs/** -text
